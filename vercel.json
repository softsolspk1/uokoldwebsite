{
  "version": 2,
  "builds": [
    {
      "src": "_router.php",
      "use": "vercel-php@0.3.8"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/admissions/2023/eveap\\.pdf",
      "status": 301,
      "headers": { "Location": "https://uokadmission.edu.pk/login" }
    },
    {
      "src": "/(.*)\\.(pdf|jpg|jpeg|png|gif|doc|docx|xls|xlsx|ppt|pptx|zip|rar|mp3|mp4|bmp|webp|swf)",
      "dest": "https://pub-fa9e1086078b499a9e91e19b8c804ba2.r2.dev/$1.$2",
      "headers": { "Cache-Control": "public, max-age=604800, s-maxage=2592000" }
    },
    {
      "src": "/(.*)\\.(css|js)$",
      "headers": { "Cache-Control": "public, max-age=3600, s-maxage=604800, stale-while-revalidate=86400" },
      "continue": true
    },
    {
      "src": "/(.*)\\.php$",
      "dest": "/_router.php",
      "headers": { "Cache-Control": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400" }
    },
    {
      "src": "/$",
      "dest": "/_router.php",
      "headers": { "Cache-Control": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400" }
    },
    {
      "src": "/(.*)/$",
      "dest": "/_router.php",
      "headers": { "Cache-Control": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400" }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/_router.php",
      "headers": { "Cache-Control": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400" }
    }
  ]
}
